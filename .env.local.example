# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. SETUP.md walks through exactly
# where each value comes from in the Firebase console.
#
# On Vercel, add the same variables under Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Public (safe in the browser) ------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# These are meant to be public. Firestore security rules, not secrecy, are
# what protect your data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Shown in the header and page titles.
NEXT_PUBLIC_SITE_NAME=Ryder

# Set to 1 only when running against the local emulators.
NEXT_PUBLIC_USE_EMULATORS=

# --- Server only (never expose these) --------------------------------------
# Firebase console -> Project settings -> Service accounts ->
# "Generate new private key". Open the downloaded JSON and copy the three
# values across.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n sequences exactly as they
# appear in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
